      "allow_unknown_bots": false,
      "allow_class_b_partners": true,
      "quarantine_action": "TARPIT_DEFLECTION_OR_CHALLENGE",
      "honeypot_triggers": ["DOM_BAIT", "RATE_SPIKE"],
      "cadence_threshold_ms": 80,
      "v_score_human_threshold": 40.0,
      "rate_limit_burst_per_min": 60,
      "partner_quotas": {
        "max_daily_default": 200,
        "max_tokens_per_call": 1024,
        "require_kill_switch_active": true
      }
    },
    "OPEN_ACADEMIC_RESEARCH": {
      "name": "Отворен Академичен & Търсачки Режим",
